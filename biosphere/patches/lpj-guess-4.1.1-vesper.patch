--- a/framework/guessmath.h	2026-08-15 18:16:40.057211009 -0600
+++ b/framework/guessmath.h	2026-08-15 18:17:18.902151951 -0600
@@ -27,6 +27,55 @@
 #endif
 const double DEGTORAD = PI / 180.;
 
+// VESPER PLANETARY CONSTANTS
+// Everything in LPJ-GUESS that assumes Earth's orbit, spin or star resolves to
+// one of these. Kept together so the assumptions are auditable in one place.
+// See <world>/biosphere/notes/lpj-guess-porting-audit.md for the derivations.
+
+/// Days in a simulation year. Vesper's orbit is 180.655 Earth days at the 0.96
+/// baseline flux; 181 steps of 24 h is 4344 h against the true 4335.7, +0.19%.
+/** The timestep stays 24 h deliberately. Every per-day rate constant in
+ *  LPJ-GUESS was calibrated against 24 h of absolute time, so a 30.209 h Vesper
+ *  day would put 25.9% into respiration, decomposition, snowmelt and phenology
+ *  alike. Stepping in Earth days confines the error to daylength, where it has
+ *  a known sign. Because 181 < 365 every per-day array is already oversized and
+ *  nothing needs reallocating.
+ */
+const int VESPER_YEAR_LENGTH_DAYS = 181;
+
+/// Stellar constant at Vesper's orbit, W/m2. 0.96 x 1361.
+const double VESPER_STELLAR_CONSTANT = 1306.56;
+
+/// Orbital eccentricity. Earth 0.01675.
+const double VESPER_ECCENTRICITY = 0.02;
+
+/// Obliquity in degrees. Earth 23.4.
+const double VESPER_OBLIQUITY_DEG = 32.0;
+
+/// Phase of the declination cycle, in days before day 0 of the simulation year.
+/** Earth's 10.5 places the December solstice ten days before 1 January. This
+ *  value was fitted to the solar declination the ExoPlaSim climatology actually
+ *  reports (`zdec`, 12 bins per orbit): rms residual 1.11 deg, max 1.95 deg.
+ *
+ *  IT ASSUMES day 0 of the LPJ-GUESS year is the first bin of the climatology.
+ *  The input module must guarantee that or the seasons run out of phase with
+ *  the forcing.
+ */
+const double VESPER_SOLSTICE_OFFSET_DAYS = 151.2;
+
+/// Fraction of shortwave that is photosynthetically active, 400-700 nm.
+/** Earth's 0.5 scaled by this star's PAR fraction against the Sun's, both
+ *  measured on the k25v BT-Settl spectrum and a 5772 K reference over the same
+ *  grid: 0.3093 / 0.3903 = 0.7926.
+ *
+ *  This is the Earth photosystem window transplanted unchanged. Lehmer et al.
+ *  2021 put the optimal peaks for a K2V at 675, 711 and 746 nm, so a biosphere
+ *  evolved here would plausibly run to about 750 nm, which would raise this to
+ *  0.48 and put photon supply at parity with Earth. Using 0.396 asserts Earth's
+ *  pigments, deliberately and conservatively.
+ */
+const double VESPER_FRADPAR = 0.396;
+
 const double SECS_PER_DAY	= 24.0*60.0*60.0;
 const double M3_PER_MM3		= 1E-9;
 const double MM3_PER_M3		= 1E9;
