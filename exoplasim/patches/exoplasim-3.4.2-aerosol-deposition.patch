+      real,intent(in) :: prec(im,jm) ! Total precipitation rate (m/s), for lwetdep
+      real ::   zdz(im,jm) ! Geometric thickness of the bottom layer (m)
+      real ::   zlam(im,jm) ! Below-cloud scavenging rate (1/s)
 
