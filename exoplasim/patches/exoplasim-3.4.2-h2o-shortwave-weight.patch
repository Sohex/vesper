        zwv(:)=zywvt(:)+zbetta*(zwvt(:)-zwvl(:,jlev))
        ztwvu(:)=ztwvtu(:)                                               &
-     &         /(1.-2.9*zwv(:)/((1.+141.5*zwv(:))**0.635+5.925*zwv(:))  &
+     &         /(1.-h2osww*2.9*zwv(:)                                   &
+     &            /((1.+141.5*zwv(:))**0.635+5.925*zwv(:))              &
      &            /zsolar2)
