+     &            /((1.+141.5*zwv(:))**0.635+5.925*zwv(:))              &
      &            /zsolar2)                                             &
      &        /ztwvt(:)
        ztwvt(:)=ztwvt(:)*ztwv(:)
@@ -2019,7 +2038,8 @@
