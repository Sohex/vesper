      "check": "the crossing discards no vector where the two grids agree",
      "residual": 2.1218377777202156e-16,
      "tolerance": 1e-12,
      "must_be": "<=",
      "passes": true,
      "detail": "a grid crossed with itself has one tangent plane, so the radial part is zero"
    },
