#!/usr/bin/env python3
"""Refuse, and say what to run instead. This wrapper is superseded by `qrun`.

    scripts/lock_and_run -m "..." <command>      # refuses, exit 2
    qrun -- <command>                            # what to run instead

WHY IT REFUSES RATHER THAN FORWARDING. This project used to be the only thing
on the host, so one lock that kept its own agents off each other was the whole
problem. The machine is now shared with other repositories and arbitrated
centrally, and this wrapper knows nothing about any of them: a job started
under it takes cores the scheduler believes are free, which is worse than the
contention the lock existed to prevent. Forwarding to `qrun` would hide that
change from the caller and pick a resource request on their behalf; a refusal
makes them read one line and choose a profile.

WHY THE FILE STAYS. Deleting it would give a stale caller `command not found`,
which reads like a broken checkout and invites working around it. Eleven
documents in this tree named this wrapper when it was superseded, and anything
written before then -- a note, an old brief, a habit -- still names it. This
refusal is what turns that into one clear redirect at the point of the mistake
rather than a silent bypass. `lib/write_door.py` refuses on the same principle.

WHAT TO RUN. `qrun` blocks, streams the command's output live and exits with
its status, so it goes exactly where this did:

    qrun -- .venv/bin/python exoplasim/scripts/run_exoplasim.py ...
    qrun -p exoplasim-omp -- ...    the OpenMP-parallel runs
    qrun -p build -- ...            compiles
    qrun -p light -- ...            a long analysis that is not CPU-bound

`.taskrunner.toml` at the repo root pins the default profile and every worktree
inherits it. CLAUDE.md's Resource scheduling section has the rules that bite:
rank and thread counts come from `$SLURM_CPUS_PER_TASK` and never `nproc`, and
a killed job is usually a limit rather than a defect. `qrun spec` prints the
live limits and the full key schema.
"""

from __future__ import annotations

import sys

MESSAGE = """\
scripts/lock_and_run is superseded and refuses rather than running anything.

This host is shared with other repositories and arbitrated by a scheduler.
This wrapper only ever excluded THIS project's agents, so a job it started
would take cores the scheduler believes are free.

Run instead:

    qrun -- <your command>

and pick a profile when the job is not one climate arm:

    qrun -p exoplasim-omp -- ...    the OpenMP-parallel runs
    qrun -p build -- ...            compiles
    qrun -p light -- ...            a long analysis that is not CPU-bound
    qrun -p exoplasim-big -- ...    all 16 cores; locks the CPU queue

Take rank and thread counts from $SLURM_CPUS_PER_TASK, never nproc.
`qrun spec` prints the live limits; CLAUDE.md has the Resource scheduling
section.\
"""


def main(argv: list[str]) -> int:
    # --self-test is what `verify_entry_points.py` calls, and it asserts this
    # refusal rather than the behaviour of the lock that used to be here.
    if argv and argv[0] == "--self-test":
        print("scripts/lock_and_run refuses: superseded by qrun")
        return 0
    print(MESSAGE, file=sys.stderr)
    return 2


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
