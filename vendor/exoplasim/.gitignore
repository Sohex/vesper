# Build, configure and install artifacts.
#
# configure.sh and compile.sh generate all of this INTO the source tree, so
# without this file every build leaves the working tree dirty. That matters
# here because this branch is consumed as a git subtree by another repository,
# where a permanently dirty vendor directory would mask real changes.
#
# Nothing listed here is tracked upstream except most_plasim_run, which is
# regenerated by compile.sh for whichever configuration was built last and is
# therefore untracked on this branch. burn7.x IS tracked and is re-included
# explicitly rather than being caught by the executable rule.

# written by configure.sh
/exoplasim/most_compiler
/exoplasim/most_compiler_mpi
/exoplasim/most_debug_options
/exoplasim/most_precision_options
/exoplasim/most_precision_optionsx
/exoplasim/most_info.txt
/exoplasim/firstrun
/exoplasim/F90_INTEGER
/exoplasim/F90_REAL
/exoplasim/cc_check.x
/exoplasim/f90check.x
/exoplasim/*.so

# written by compile.sh at the package root for the configuration being built
/exoplasim/MPI
/exoplasim/makefile
/exoplasim/resmod.f90
/exoplasim/compilerargs

# compile.sh stages sources, objects and modules here; none of it is tracked
/exoplasim/plasim/bld/
/exoplasim/plasim/bin/

# compiled model executables land beside the tracked run inputs
/exoplasim/plasim/run/*.x
!/exoplasim/plasim/run/burn7.x
/exoplasim/plasim/run/most_plasim_run

# raw model output, written in place by a run started from the source tree
/exoplasim/plasim/run/MOST*
/exoplasim/plasim/run/plasim_output
/exoplasim/plasim/run/plasim_snapshot
/exoplasim/plasim/run/plasim_status
/exoplasim/plasim/run/plasim_restart
/exoplasim/plasim/run/plasim_diag
/exoplasim/plasim/run/*_output

__pycache__/
*.pyc
*.pyo
*.orig
*.rej
