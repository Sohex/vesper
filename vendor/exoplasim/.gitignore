# Build, configure and install artifacts.
#
# This branch is consumed as a git subtree by another repository, where a
# permanently dirty vendor directory would mask real changes, so anything a
# build can leave inside the source tree is listed here.
#
# The build that wrote most of it is GONE. `exoplasim/scripts/build_model.py`
# drives CMake and Ninja out of tree, into a build directory outside this
# subtree, and the executable is installed into plasim/run. The rules for the
# files the old configure and compile scripts generated are kept because a
# working tree that once had them still does, and a stale most_compiler or
# resmod.f90 appearing as an untracked file is noise rather than news.

# written by the build system this fork replaced
/exoplasim/most_compiler
/exoplasim/most_compiler_mpi
/exoplasim/most_debug_options
/exoplasim/most_precision_options
/exoplasim/most_precision_optionsx
/exoplasim/most_info.txt
/exoplasim/firstrun
/exoplasim/F90_INTEGER
/exoplasim/F90_REAL
/exoplasim/cc_check.x
/exoplasim/f90check.x
/exoplasim/*.so

# written at the package root by that same build, for the configuration built
/exoplasim/MPI
/exoplasim/makefile
/exoplasim/resmod.f90
/exoplasim/compilerargs

# staged sources, objects and modules; none of it is tracked
/exoplasim/plasim/bld/
/exoplasim/plasim/bin/

# compiled model executables land beside the tracked run inputs
/exoplasim/plasim/run/*.x
!/exoplasim/plasim/run/burn7.x
/exoplasim/plasim/run/most_plasim_run

# raw model output, written in place by a run started from the source tree
/exoplasim/plasim/run/MOST*
/exoplasim/plasim/run/plasim_output
/exoplasim/plasim/run/plasim_snapshot
/exoplasim/plasim/run/plasim_status
/exoplasim/plasim/run/plasim_restart
/exoplasim/plasim/run/plasim_diag
/exoplasim/plasim/run/*_output

__pycache__/
*.pyc
*.pyo
*.orig
*.rej
